{
  "name": "thomaps",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/check-pwa.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "check:catalog": "node scripts/check-catalog.mjs",
    "check:pwa": "node scripts/check-pwa.mjs",
    "report:catalog": "node scripts/report-catalog.mjs",
    "test:layout": "playwright test",
    "format": "prettier --write src tests scripts *.ts *.js *.json",
    "format:check": "prettier --check src tests scripts *.ts *.js *.json",
    "assets:map": "node scripts/prepare-map-data.mjs",
    "assets:anthems": "node scripts/prepare-anthems.mjs",
    "assets:icons": "node scripts/generate-pwa-icons.mjs"
  },
  "dependencies": {
    "@fontsource/nunito": "5.3.0",
    "@gsap/react": "2.1.2",
    "d3-geo": "3.1.1",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "gsap": "3.15.0",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "topojson-client": "3.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/d3-geo": "3.1.1",
    "@types/d3-selection": "3.0.12",
    "@types/d3-zoom": "3.0.9",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.4",
    "topojson-server": "3.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  }
}
